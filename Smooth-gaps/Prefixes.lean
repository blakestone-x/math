import Families

namespace SmoothGaps

/-- Four base-64 digits encode the exponents of 2, 3, 5 and q. We put
    q = 1 for five-smooth witnesses and q = 7 for seven-smooth witnesses. -/
private def expand (q a : ℕ) : ℕ :=
  2^(a%64) * 3^(a/64%64) * 5^(a/4096%64) * q^(a/262144)

private theorem expand_smooth {S : Finset ℕ} {q : ℕ}
    (p2 : Smooth S 2) (p3 : Smooth S 3) (p5 : Smooth S 5) (hq : Smooth S q)
    (a : ℕ) : Smooth S (expand q a) :=
  (((p2.pow _).mul (p3.pow _)).mul (p5.pow _)).mul (hq.pow _)

private def valid (q cut n : ℕ) (p : ℕ × ℕ) : Bool :=
  let x := expand q p.1
  let y := expand q p.2
  decide (x = n+y ∨ (cut ≤ n ∧ n = x+y))

def WitnessAt (S : Finset ℕ) (cut n : ℕ) : Prop :=
  ∃ x, Attains S n x ∧ (n < cut → n < x)

private theorem valid_sound {S : Finset ℕ} {q cut n : ℕ} {p : ℕ × ℕ}
    (sm : ∀ a, Smooth S (expand q a)) (good : valid q cut n p = true) :
    WitnessAt S cut n := by
  have h : expand q p.1 = n+expand q p.2 ∨
      (cut ≤ n ∧ n = expand q p.1+expand q p.2) := of_decide_eq_true good
  have ypos := Nat.pos_of_ne_zero (sm p.2).1
  refine ⟨expand q p.1, ⟨sm p.1, expand q p.2, sm p.2, h.imp_right And.right⟩, ?_⟩
  intro hcut
  rcases h with h | h <;> omega

private def blockOK (q cut : ℕ) : ℕ → List (ℕ × ℕ) → Bool
  | _, [] => true
  | n, p :: ps => valid q cut n p && blockOK q cut (n+1) ps

private theorem block_sound {S : Finset ℕ} {q cut i : ℕ}
    (sm : ∀ a, Smooth S (expand q a)) (ps : List (ℕ × ℕ)) (start : ℕ)
    (ok : blockOK q cut start ps = true) (lo : start ≤ i) (hi : i < start+ps.length) :
    WitnessAt S cut i := by
  induction ps generalizing start with
  | nil => simp at hi; omega
  | cons p ps ih =>
    obtain ⟨hp, rest⟩ := Bool.and_eq_true_iff.mp ok
    rcases eq_or_lt_of_le lo with e | e
    · subst i; exact valid_sound sm hp
    · apply ih (start+1) rest e
      simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using hi

private def blocksOK (q cut : ℕ) : ℕ → List (List (ℕ × ℕ)) → Bool
  | _, [] => true
  | n, b :: bs => blockOK q cut n b && blocksOK q cut (n+b.length) bs

private def total : List (List (ℕ × ℕ)) → ℕ
  | [] => 0
  | b :: bs => b.length + total bs

private theorem blocks_sound {S : Finset ℕ} {q cut i : ℕ}
    (sm : ∀ a, Smooth S (expand q a)) (bs : List (List (ℕ × ℕ))) (start : ℕ)
    (ok : blocksOK q cut start bs = true) (lo : start ≤ i) (hi : i < start+total bs) :
    WitnessAt S cut i := by
  induction bs generalizing start with
  | nil => simp [total] at hi; omega
  | cons b bs ih =>
    obtain ⟨checked, rest⟩ := Bool.and_eq_true_iff.mp ok
    by_cases h : i < start+b.length
    · exact block_sound sm b start checked lo h
    · apply ih (start+b.length) rest (by omega)
      simpa only [total, Nat.add_assoc] using hi

