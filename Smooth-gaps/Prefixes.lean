theorem beforeFirstZeroFive {n : ℕ} (lo : 1 ≤ n) (hi : n < 583) :
    WitnessAt primesFive 281 n := by
  have p2 : Smooth primesFive 2 := smooth_prime (by decide) (by decide)
  have p3 : Smooth primesFive 3 := smooth_prime (by decide) (by decide)
  have p5 : Smooth primesFive 5 := smooth_prime (by decide) (by decide)
  have hq : Smooth primesFive 1 := by simp [Smooth]
  apply blocks_sound (expand_smooth p2 p3 p5 hq) certFive 1 _ lo
  · have size : 1+total certFive = 583 := by decide
    rwa [size]
  · decide

#print axioms beforeFirstZeroFive

