/-- The generalized square pyramidal number at an integer index. -/
def P (t : ℤ) : ℤ := t*(t+1)*(2*t+1)/6

theorem reflected (t : ℤ) : P (-t-1) = -(P t) := by
  unfold P
  rw [show (-t-1)*(-t-1+1)*(2*(-t-1)+1) = -(t*(t+1)*(2*t+1)) by ring]
  apply Int.neg_ediv_of_dvd
  have hm : 0 ≤ t%6 ∧ t%6 < 6 := ⟨Int.emod_nonneg _ (by decide), Int.emod_lt_of_pos _ (by decide)⟩
  apply Int.dvd_of_emod_eq_zero
  have hr : t*(t+1)*(2*t+1) ≡ t%6*(t%6+1)*(2*(t%6)+1) [ZMOD 6] :=
    ((Int.mod_modEq _ _).symm.mul ((Int.mod_modEq _ _).symm.add (Int.ModEq.refl 1))).mul
      (((Int.ModEq.refl 2).mul (Int.mod_modEq _ _).symm).add (Int.ModEq.refl 1))
  change _ % 6 = _ % 6 at hr
  rw [hr]
  have cases : t%6=0 ∨ t%6=1 ∨ t%6=2 ∨ t%6=3 ∨ t%6=4 ∨ t%6=5 := by omega
  rcases cases with h|h|h|h|h|h <;> rw [h] <;> decide

private theorem from_block (base size n : ℕ) (table : List (ℤ × ℤ × ℤ))
    (checked : table.map (fun w => P w.1 + P w.2.1 + P w.2.2) =
      (List.range size).map (fun j : ℕ => ((base+j : ℕ) : ℤ)))
    (lo : base ≤ n) (hi : n < base+size) :
    ∃ a b c : ℤ, (n : ℤ) = P a + P b + P c := by
  have member : (n : ℤ) ∈ (List.range size).map (fun j : ℕ => ((base+j : ℕ) : ℤ)) :=
    List.mem_map.mpr ⟨n-base, List.mem_range.mpr (by omega), by simp [Nat.add_sub_of_le lo]⟩
  rw [← checked] at member
  obtain ⟨⟨a,b,c⟩,_,e⟩ := List.mem_map.mp member
  exact ⟨a,b,c,e.symm⟩

