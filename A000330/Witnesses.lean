theorem interval_witness (z : ℤ) (lo : -2048 ≤ z) (hi : z ≤ 2048) :
    ∃ a b c : ℤ, z = P a + P b + P c := by
  by_cases h : 0 ≤ z
  · obtain ⟨a,b,c,e⟩ := positive_witness ⟨z.toNat, by omega⟩
    exact ⟨a,b,c,by simpa [Int.toNat_of_nonneg h] using e⟩
  · obtain ⟨a,b,c,e⟩ := positive_witness ⟨(-z).toNat, by omega⟩
    refine ⟨-a-1,-b-1,-c-1,?_⟩
    rw [reflected, reflected, reflected]
    change ((-z).toNat : ℤ) = _ at e
    omega

